# Local development only. In production, set these in your deployment's environment.
# Never commit a real .env.

BASE_URL=http://localhost:7000
# openssl rand -hex 32 — never change it later: stored configs become unreadable.
SECRET_KEY=
# Optional code new users enter on the configure page (at least 8 characters).
# Leave it out for open signup.
# SIGNUP_CODE=
# Consumer key from https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
DATA_DIR=./data
PORT=7000
