{
  "name": "subs-dennie-io",
  "version": "0.5.0",
  "private": true,
  "description": "Stremio subtitle addon that signs in to subtitle providers with each user's own account.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/ui dist/ui",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.7",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
